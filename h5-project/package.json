{
  "name": "h5-brochure-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode development",
    "prod": "vite --host 0.0.0.0 --mode production",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "build:test": "vue-tsc --noEmit && vite build --mode development",
    "build:single": "vue-tsc --noEmit && node scripts/build-single-html.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "tag": "bash ./tag.sh"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "^8.0.2",
    "@vitejs/plugin-vue": "^6.0.2",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vant": "^4.9.21",
    "vue": "^3.5.24",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.9.2",
    "@vant/auto-import-resolver": "^1.3.0",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.0",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.0.0",
    "vue-tsc": "^3.1.5"
